{
  "openapi": "3.0.3",
  "info": {
    "title": "Swagger Petstore",
    "version": "1.0.0",
    "description": "示例宠物商店接口，用于演示 PostCat 的 OpenAPI 文档展示与在线调试。"
  },
  "servers": [{ "url": "https://petstore3.swagger.io/api/v3", "description": "Swagger 官方演示服务" }],
  "tags": [
    { "name": "pet", "description": "宠物管理" },
    { "name": "store", "description": "订单管理" },
    { "name": "user", "description": "用户管理" }
  ],
  "paths": {
    "/pet": {
      "post": {
        "tags": ["pet"],
        "summary": "新增宠物",
        "operationId": "addPet",
        "requestBody": {
          "required": true,
          "description": "要新增的宠物",
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "405": { "description": "参数不合法" }
        }
      },
      "put": {
        "tags": ["pet"],
        "summary": "更新宠物",
        "operationId": "updatePet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "404": { "description": "宠物不存在" }
        }
      }
    },
    "/pet/findByStatus": {
      "get": {
        "tags": ["pet"],
        "summary": "按状态查询宠物",
        "description": "多个状态可用逗号分隔",
        "operationId": "findPetsByStatus",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "宠物状态",
            "required": false,
            "schema": { "type": "string", "default": "available", "enum": ["available", "pending", "sold"] }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }
              }
            }
          },
          "400": { "description": "状态值不合法" }
        }
      }
    },
    "/pet/findByTags": {
      "get": {
        "tags": ["pet"],
        "summary": "按标签查询宠物",
        "description": "多个标签可用逗号分隔，如 tag1,tag2",
        "operationId": "findPetsByTags",
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "description": "标签",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }
              }
            }
          },
          "400": { "description": "标签不合法" }
        }
      }
    },
    "/pet/{petId}/uploadImage": {
      "post": {
        "tags": ["pet"],
        "summary": "上传宠物图片",
        "operationId": "uploadFile",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "description": "宠物 ID",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "example": 10 }
          },
          { "name": "additionalMetadata", "in": "query", "description": "附加信息", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/pet/{petId}": {
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "description": "宠物 ID",
          "required": true,
          "schema": { "type": "integer", "format": "int64", "example": 10 }
        }
      ],
      "get": {
        "tags": ["pet"],
        "summary": "查询宠物详情",
        "operationId": "getPetById",
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "404": { "description": "宠物不存在" }
        }
      },
      "post": {
        "tags": ["pet"],
        "summary": "表单更新宠物",
        "operationId": "updatePetWithForm",
        "parameters": [
          { "name": "name", "in": "query", "description": "宠物名称", "required": false, "schema": { "type": "string" } },
          {
            "name": "status",
            "in": "query",
            "description": "宠物状态",
            "required": false,
            "schema": { "type": "string", "enum": ["available", "pending", "sold"] }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          },
          "400": { "description": "参数不合法" }
        }
      },
      "delete": {
        "tags": ["pet"],
        "summary": "删除宠物",
        "operationId": "deletePet",
        "deprecated": true,
        "parameters": [{ "name": "api_key", "in": "header", "required": false, "schema": { "type": "string" } }],
        "responses": { "400": { "description": "ID 不合法" } }
      }
    },
    "/store/order": {
      "post": {
        "tags": ["store"],
        "summary": "下单",
        "operationId": "placeOrder",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Order" } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          }
        }
      }
    },
    "/store/order/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "description": "订单 ID",
          "required": true,
          "schema": { "type": "integer", "format": "int64", "example": 10 }
        }
      ],
      "get": {
        "tags": ["store"],
        "summary": "查询订单",
        "operationId": "getOrderById",
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "404": { "description": "订单不存在" }
        }
      },
      "delete": {
        "tags": ["store"],
        "summary": "删除订单",
        "operationId": "deleteOrder",
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "订单不存在" }
        }
      }
    },
    "/store/inventory": {
      "get": {
        "tags": ["store"],
        "summary": "查询库存",
        "operationId": "getInventory",
        "responses": {
          "200": {
            "description": "按状态统计的库存数",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "integer", "format": "int32" } }
              }
            }
          }
        }
      }
    },
    "/user": {
      "post": {
        "tags": ["user"],
        "summary": "创建用户",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    },
    "/user/createWithList": {
      "post": {
        "tags": ["user"],
        "summary": "批量创建用户",
        "operationId": "createUsersWithListInput",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } } }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    },
    "/user/login": {
      "get": {
        "tags": ["user"],
        "summary": "用户登录",
        "operationId": "loginUser",
        "parameters": [
          { "name": "username", "in": "query", "description": "用户名", "required": false, "schema": { "type": "string", "example": "user1" } },
          { "name": "password", "in": "query", "description": "密码", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "type": "string" } } }
          },
          "400": { "description": "用户名或密码错误" }
        }
      }
    },
    "/user/logout": {
      "get": {
        "tags": ["user"],
        "summary": "退出登录",
        "operationId": "logoutUser",
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/user/{username}": {
      "parameters": [
        { "name": "username", "in": "path", "description": "用户名", "required": true, "schema": { "type": "string", "example": "user1" } }
      ],
      "get": {
        "tags": ["user"],
        "summary": "查询用户",
        "operationId": "getUserByName",
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "404": { "description": "用户不存在" }
        }
      },
      "put": {
        "tags": ["user"],
        "summary": "更新用户",
        "operationId": "updateUser",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
          }
        },
        "responses": { "200": { "description": "成功" } }
      },
      "delete": {
        "tags": ["user"],
        "summary": "删除用户",
        "operationId": "deleteUser",
        "responses": {
          "400": { "description": "用户名不合法" },
          "404": { "description": "用户不存在" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "name": { "type": "string", "example": "Dogs" },
          "parent": { "$ref": "#/components/schemas/Category" }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "BaseEntity": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 10, "description": "唯一 ID" }
        }
      },
      "Pet": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseEntity" },
          {
            "type": "object",
            "required": ["name", "photoUrls"],
            "properties": {
              "name": { "type": "string", "example": "doggie", "description": "宠物名称" },
              "category": { "$ref": "#/components/schemas/Category" },
              "photoUrls": { "type": "array", "items": { "type": "string" } },
              "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
              "status": {
                "type": "string",
                "description": "宠物状态",
                "enum": ["available", "pending", "sold"]
              }
            }
          }
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 10 },
          "petId": { "type": "integer", "format": "int64", "example": 198772 },
          "quantity": { "type": "integer", "format": "int32", "example": 7 },
          "shipDate": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["placed", "approved", "delivered"] },
          "complete": { "type": "boolean" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 10 },
          "username": { "type": "string", "example": "theUser" },
          "email": { "type": "string", "example": "john@email.com" },
          "phone": { "type": "string" }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "type": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
